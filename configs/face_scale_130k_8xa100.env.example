# FACE 130k / 100k-step / 8x A100 target profile.
#
# This file is an execution contract, not a launched run. Source it when the
# DDP/multi-node launcher is ready, or use the same values in the equivalent
# Thunder/cloud provider launch config.

# Data/corpus
SELECT_TARGET=130000
CURATION_TARGET=130000
SCAN_LIMIT=800000
MIN_QUALITY=2
TARGET_FACES=512
TOKEN_MAX_FACES=512
MODEL_MAX_FACES=512
NUM_BINS=128
PAPER_WITHIN_FACE_ORDER=rotate_min_zyx
DEDUPE_TOKEN_SPLIT=1
DEDUPE_COPY_MODE=hardlink

# Paper FACE input/latent
POINT_SAMPLES=8192
VECSET_TOKENS=2048
LATENT_DIM=64
ENCODER_BACKEND=shape2vecset

# Paper-scale ARAE capacity
HIDDEN_SIZE=1024
ENCODER_HIDDEN_SIZE=768
ENCODER_LAYERS=8
DECODER_LAYERS=24
HEADS=16
FACE_EMBEDDING_VARIANT=token_concat_project
CAUSAL_MLP_VARIANT=legacy_concat
DECODE_HEAD=causal

# Optimizer/training
STEPS=100000
BATCH_SIZE=1
OPTIMIZER=muon
LR=0.0006
WEIGHT_DECAY=0.1
PRECISION=bf16
DISTRIBUTED=auto
DISTRIBUTED_BACKEND=nccl
TORCHRUN_NPROC_PER_NODE=8
SEED=303

# Paper augmentation
DISABLE_AUGMENT=0
AUGMENT_ROTATION=so3
AUGMENT_SCALE_MIN=0.75
AUGMENT_SCALE_MAX=1.25
AUGMENT_FLIP_PROB=0.5
CACHE_FPS_INDICES=0

# Strictness/safety
STRICT_FACE_PAPER_GATE=1
ALLOW_DEPRECATED_FACE_EMBEDDING=0
SPLIT_INTEGRITY_IDENTITY_LIMIT=64

# FACE-native curriculum knobs. Keep these at baseline for pure paper training.
# Enable only for named curriculum continuations if the bounded probes justify it.
FIRST_FACE_LOSS_WEIGHT=1.0
LOSS_FACE_PREFIX_COUNT=0
FIRST_FACE_TIE_MARGINAL_LOSS=0
INPUT_FACE_TOKEN_NOISE_PROB=0.0
INPUT_FACE_TOKEN_NOISE_MAX_OFFSET=1
INPUT_FACE_NOISE_PREFIX_COUNT=0
TOPOLOGY_REUSE_WEIGHT=0.0
TOPOLOGY_EDGE_CLOSURE_WEIGHT=0.0

# Eval cadence for scale. Full AR is expensive; use sparse full eval plus
# first-face/short-rollout milestone probes.
LOG_EVERY=100
SELECTION_EVAL_EVERY=5000
SELECTION_EVAL_BATCH_SIZE=2
CHECKPOINT_EVERY=5000
SAVE_CURRENT_CHECKPOINT=1
TEACHER_FORCED_LIMIT=512
AR_LIMIT=64
AR_FACE_LIMIT=512
TEACHER_PREFIX_LIMIT=64
TEACHER_PREFIX_FACE_COUNTS="1 4 16 64"
PREDICTED_LIMIT=32
PREDICTED_FACE_LIMIT=512
PAIR_SAMPLES=1000
MIN_SCALE_DATASET_SAMPLES=100000
