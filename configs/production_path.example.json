{
  "project_id": "production_benchmark",
  "coarse_adapter_enabled": true,
  "coarse_adapter_engine": "auto",
  "coarse_adapter_target_faces": 150000,
  "coarse_adapter_sample_points": 180000,
  "coarse_adapter_min_component_faces": 64,
  "coarse_adapter_keep_largest_components": 128,
  "coarse_adapter_max_output_components": 1,
  "coarse_adapter_max_boundary_loops": 25,
  "coarse_adapter_max_nonmanifold_edges": 1000,
  "coarse_adapter_require_watertight": false,
  "coarse_adapter_voxel_resolution": 192,
  "coarse_adapter_voxel_dilate": 2,
  "coarse_adapter_voxel_close": 1,
  "coarse_adapter_mesh_voxel_max_faces": 75000,
  "coarse_adapter_hull_max_points": 20000,
  "coarse_adapter_fallback": "convex_hull",
  "reference_refinement_enabled": true,
