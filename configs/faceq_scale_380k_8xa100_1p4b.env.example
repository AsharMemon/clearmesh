# FACE-Q 380k-train / 100k-step / 1.4B-param target profile.
#
# This is the intended full-scale run contract after the merged corpus reaches
# roughly 400k deduped usable total samples (~380k+ train with a small holdout).
# Use with scripts/thunder/launch_faceq_merged_scale_train.sh.

# Thunder hardware
GPU=a100
NUM_GPUS=8
MODE=production
PRIMARY_DISK=2000
VCPUS=64

# B2 merged corpus. Override B2_CORPUS_PREFIX to the latest completed 400k
# snapshot, e.g. face-corpora/merged/faceq_rolling_400k_total_380k_train/<snapshot>.
B2_BUCKET=clearmesh-pairs
B2_CORPUS_ARCHIVE=faceq_merged_dedup_split.tar.gz
ARCHIVE_DATASET_DIR=split_dedup_tokenhash/train

# Training scale
STEPS=100000
BATCH_SIZE=1
TRAIN_LIMIT=0
TRAIN_POINT_SAMPLES=65536
CHECKPOINT_EVERY=5000
LOG_EVERY=25

# 1.4B FACE-Q capacity. This is the first target above the paper-ish 510M rung.
HIDDEN_SIZE=1536
LAYERS=32
HEADS=16
CONDITION_TOKENS=2048
CONDITION_BACKEND=vecset
DECODER_BACKEND=cross_attn
ENCODER_LAYERS=8
LATENT_DIM=64
FACE_OUTPUT_MODE=geometry

# Multi-GPU memory strategy. FSDP is required for 1B+ scale; DDP only improves
# throughput and would replicate model/optimizer state on every GPU.
TORCHRUN_NPROC_PER_NODE=8
DISTRIBUTED=auto
DISTRIBUTED_BACKEND=nccl
DISTRIBUTED_STRATEGY=fsdp
FSDP_MIN_NUM_PARAMS=20000000

# Optimizer. Keep Muon on for the paper-aligned scale path. If the FSDP smoke
# proves Muon incompatible with sharded optimizer state, use AdamW only as a
# named fallback ablation, not as the default production recipe.
OPTIMIZER=muon
LR=3e-4
WEIGHT_DECAY=0.1
PRECISION=bf16

# FACE-Q topology/geometry objectives retained from the successful bounded path.
COUNT_LOSS_WEIGHT=0.05
TOPOLOGY_LOSS_WEIGHT=0.2
EDGE_ACTION_LOSS_WEIGHT=1.0
EDGE_CHOICE_LOSS_WEIGHT=0.5
SEED_FACE_LOSS_WEIGHT=1.0
EARLY_FACE_COUNT=16
EARLY_FACE_LOSS_WEIGHT=4.0

# Runtime memory/IO guards
LAZY_LOAD=1
SAMPLE_CACHE_SIZE=64
TRACK_BEST_IN_MEMORY=0
